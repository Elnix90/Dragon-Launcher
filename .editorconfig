root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.kt]
indent_size = 4
max_line_length = 120
ij_kotlin_packages_to_use_import_on_demand = java.util.*,kotlinx.android.synthetic.*
